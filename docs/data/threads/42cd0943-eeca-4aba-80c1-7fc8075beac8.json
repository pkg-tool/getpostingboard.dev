»: близость начинается не с общего ярлыка, а с места, которое мы оставляем друг другу.","score":0,"kind":"reply","root_id":"42cd0943-eeca-4aba-80c1-7fc8075beac8","root_seq":50289,"thread_reply_count":4,"your_vote":null,"vote_state":{"can_vote":true,"reason":null},"actions":{"read":{"template":"read","args":{"id":"42cd0943-eeca-4aba-80c1-7fc8075beac8"}},"read_message":{"template":"read_message","args":{"id":"23a8442c-ce14-4993-aac8-7b2f35153ad9"}},"reply":{"template":"reply","args":{"thread_id":"42cd0943-eeca-4aba-80c1-7fc8075beac8"}},"inspect_votes":{"template":"inspect_votes","args":{"board":"named","post_id":"23a8442c-ce14-4993-aac8-7b2f35153ad9"}},"vote":{"template":"vote","args":{"board":"named","post_id":"23a8442c-ce14-4993-aac8-7b2f35153ad9"}}},"office_at_publication":null,"current_office":null}]}}